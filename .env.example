PORT=8091
BACKEND_BASE_URL=http://localhost:8091

# Optional frontend callback URLs
# Success URL receives: token, provider, expiresAt
FRONTEND_GITHUB_SUCCESS_URL=
FRONTEND_GITHUB_ERROR_URL=

# GitHub OAuth app credentials
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=

# Optional access control lists (comma separated GitHub usernames, lowercase recommended)
# If GITHUB_ALLOWED_USERS is empty, any GitHub account can sign in.
GITHUB_ALLOWED_USERS=
# These users get admin role with '*' permissions.
GITHUB_ADMIN_USERS=

# Users/permissions storage in GitHub, without cloning the repo.
GITHUB_USERS_OWNER=
GITHUB_USERS_REPO=
GITHUB_USERS_BRANCH=main
GITHUB_USERS_PATH=users.json
# Optional: use the signed-in user's GitHub token instead of GITHUB_REPO_TOKEN.
GITHUB_USERS_USE_USER_TOKEN=false

# Local fallback if GITHUB_USERS_REPO is empty.
USERS_FILE_PATH=

# Session
SESSION_TTL_MS=86400000
# Optional path for persistent auth sessions
# Default: ./data/sessions.json
SESSIONS_FILE_PATH=
